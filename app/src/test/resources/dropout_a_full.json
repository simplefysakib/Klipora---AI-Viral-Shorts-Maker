 "segments": [
  {
   "start": 0.0,
   "end": 3.6,
   "text": " बस्तों, आज तो मेरे साथ, असली नोपिता बैटा है",
   "compression_ratio": 2.22,
   "no_speech_prob": 0.01
  },
  {
   "start": 3.6,
   "end": 5.1,
   "text": " नोपिता बैटा बनादिया मुझे",
   "compression_ratio": 2.22,
   "no_speech_prob": 0.01
  },
  {
   "start": 5.1,
   "end": 7.76,
   "text": " आई, ये है, दोरे मोन की आवास",
   "compression_ratio": 2.22,
   "no_speech_prob": 0.01
  },
  {
   "start": 7.76,
   "end": 10.62,
   "text": " मैं, पुरा बच्पन मैंने सावास को से ना, तोड़ अर वात कर, अच्छा लगे",
   "compression_ratio": 2.22,
   "no_speech_prob": 0.01
  },
  {
   "start": 10.62,
   "end": 13.42,
   "text": " नो बता, आज में तो में कोई गाजेट तेई दूंगा",
   "compression_ratio": 2.83,
   "no_speech_prob": 0.01
  },
  {
   "start": 13.42,
   "end": 14.96,
   "text": " तुम हमेश आज़ा यह करते हो",
   "compression_ratio": 2.83,
   "no_speech_prob": 0.01
  },
  {
   "start": 14.96,
   "end": 17.38,
   "text": " हमेश आज़ा मेरे गाजेट का गलत असमाल करते हो",
   "compression_ratio": 2.83,
   "no_speech_prob": 0.01
  },
  {
   "start": 17.38,
   "end": 33.48,
   "text": " नहीं मैं कुछ नहीं करुँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँँ�",
   "compression_ratio": 6.51,
   "no_speech_prob": 0.006
  },
  {
   "start": 33.48,
   "end": 34.92,
   "text": " राम दोरिवान लेगा मैंने कभी सोचा नीता",
   "compression_ratio": 1.23,
   "no_speech_prob": 0.084
  }
 ],
