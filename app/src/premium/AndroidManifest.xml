<?xml version="1.0" encoding="utf-8"?>
<!-- Premium edition: no ads, so the ad SDK's own start-up hook is left out (nothing of the ad SDK runs at all).
     The other start-up hooks (lifecycle, emoji, WorkManager, profile installer) stay exactly as in the normal app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.unity3d.services.core.configuration.AdsSdkInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
