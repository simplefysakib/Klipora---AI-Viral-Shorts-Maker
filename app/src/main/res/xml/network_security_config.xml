<?xml version="1.0" encoding="utf-8"?>
<!-- v10: HTTPS only. No plain-HTTP traffic, only the system's trusted certificate authorities (no user-added CAs,
     so a proxy certificate installed on the phone can't read the app's API traffic). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
