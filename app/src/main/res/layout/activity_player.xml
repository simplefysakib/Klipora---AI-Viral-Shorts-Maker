<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">
    <VideoView android:id="@+id/videoView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"/>
    <ImageView android:id="@+id/btnClose" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="14dp" android:padding="10dp" android:background="@drawable/bg_badge" android:src="@drawable/ic_v_close" app:tint="@color/white" android:contentDescription="Close"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#99000000">
        <ImageView android:id="@+id/btnPlayPause" android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp" android:src="@drawable/ic_v_play" app:tint="@color/white" android:contentDescription="Play"/>
        <TextView android:id="@+id/tvCurrentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="00:00" android:textColor="@color/white" android:textSize="12sp"/>
        <SeekBar android:id="@+id/seekBar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:progressTint="@color/kl_primary" android:thumbTint="@color/white"/>
        <TextView android:id="@+id/tvTotalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="@color/white" android:textSize="12sp"/>
    </LinearLayout>
</FrameLayout>
