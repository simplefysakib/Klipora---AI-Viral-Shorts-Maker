                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rules for using Klipora" style="@style/Kl.Body" android:textSize="11sp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:rotation="180" android:src="@drawable/ic_v_back" app:tint="@color/kl_text_dim" android:contentDescription="@null"/>
                </LinearLayout>
                <TextView android:id="@+id/tvLegalDisclaimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Klipora is not affiliated with YouTube or Google. Only use content you own or have permission to use." style="@style/Kl.Body" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tvAppVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Klipora" style="@style/Kl.Body" android:textSize="11sp"/>
        </LinearLayout>
</androidx.core.widget.NestedScrollView>
